{
  "manifest_version": 3,
  "name": "CareerCraft AI — Apply Assistant",
  "version": "0.4.0",
  "description": "Fills and submits job applications in your own browser, under your review, using your CareerCraft AI profile and saved answers.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "tabGroups"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://www.careercraftsai.me/*",
    "https://careercraftsai.me/*",
    "https://app.careercraftsai.me/*",
    "https://www.linkedin.com/*",
    "https://*.naukri.com/*",
    "https://www.naukri.com/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://apply.workable.com/*",
    "https://*.icims.com/*",
    "https://*.taleo.net/*",
    "https://*.successfactors.com/*",
    "https://*.successfactors.eu/*",
    "https://*.darwinbox.in/*",
    "https://*.darwinbox.com/*",
    "https://*.keka.com/*",
    "https://*.indeed.com/*",
    "https://www.foundit.in/*",
    "https://www.instahyre.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "minimum_chrome_version": "110",
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://careercraftsai.me/*",
        "https://app.careercraftsai.me/*",
        "https://www.careercraftsai.me/*"
      ],
      "js": [
        "src/content/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
