    "colorMode": "background",
    "textMode": "value"
   },
   "targets": [
    {
     "expr": "100 - avg(rate(node_cpu_seconds_total{instance=\"app-vm\",mode=\"idle\"}[2m])) * 100",
     "refId": "A",
