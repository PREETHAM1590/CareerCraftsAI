// APP VM collector:
//  - every container's stdout/stderr -> Loki (labels: project, service, level)
//  - host nginx timing log (/var/log/nginx/timing.log, JSON with request
//    time) -> Loki, for request rate / latency / errors
//  - Postgres and Redis exporters -> Prometheus (remote write)
// Secrets come from /opt/careercraft-secrets/monitoring.env:
//   PG_MONITOR_DSN, REDIS_PASSWORD

// ── Container logs ──────────────────────────────────────────────────────
discovery.docker "containers" {
  host = "tcp://127.0.0.1:12375"
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    target_label = "instance"
    replacement  = "app-vm"
  }
}

loki.source.docker "containers" {
  host          = "tcp://127.0.0.1:12375"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.levels.receiver]
}

// Pull a log level out of common formats so Grafana can filter by it.
loki.process "levels" {
  // Idle containers' last lines can be weeks old; Docker re-sends them when
  // Alloy reconnects and Loki rejects anything past its 1-week window.
  stage.drop {
    older_than          = "160h"
    drop_counter_reason = "too_old"
  }
  stage.regex {
    expression = "(?i)\\b(?P<level>debug|info|warning|warn|error|critical|fatal)\\b"
  }
  // One label value per level whatever the case ("INFO" and "info").
  stage.template {
    source   = "level"
    template = "{{ ToLower .Value }}"
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.local.receiver]
}

// ── Host nginx request timing ───────────────────────────────────────────
local.file_match "nginx_timing" {
  path_targets = [{
    "__path__" = "/var/log/nginx/timing.log",
    "job"      = "nginx",
    "instance" = "app-vm",
  }]
}

loki.source.file "nginx_timing" {
  targets    = local.file_match.nginx_timing.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:19310/loki/api/v1/push"
  }
}

// ── Postgres and Redis metrics ──────────────────────────────────────────
prometheus.exporter.postgres "app" {
  data_source_names = [sys.env("PG_MONITOR_DSN")]
}

prometheus.scrape "postgres" {
  targets         = prometheus.exporter.postgres.app.targets
  job_name        = "postgres"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.app.receiver]
}

prometheus.exporter.redis "app" {
  redis_addr     = "127.0.0.1:18179"
  redis_password = sys.env("REDIS_PASSWORD")
}

prometheus.scrape "redis" {
  targets         = prometheus.exporter.redis.app.targets
  job_name        = "redis"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.app.receiver]
}

prometheus.relabel "app" {
  rule {
    target_label = "instance"
    replacement  = "app-vm"
  }
  forward_to = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://127.0.0.1:19090/api/v1/write"
  }
}
